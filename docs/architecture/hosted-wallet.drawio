        <mxCell id="m9" value="1. submits the request for an address" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="130" as="sourcePoint"/><mxPoint x="350" y="130" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="2. create request (policy request_laadpaal)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="176" as="sourcePoint"/><mxPoint x="580" y="176" as="targetPoint"/></mxGeometry></mxCell>
