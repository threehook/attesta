        <mxCell id="m12" value="4. send the browser to the wallet link" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="268" as="sourcePoint"/><mxPoint x="120" y="268" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="5. opens the wallet (already signed in)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="314" as="sourcePoint"/><mxPoint x="810" y="314" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m14" value="6. resolve the request; is this app allowed?" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="360" as="sourcePoint"/><mxPoint x="1040" y="360" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m15" value="7. what is asked, by whom" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="406" as="sourcePoint"/><mxPoint x="810" y="406" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m16" value="8. confirms with the passkey (tied to this request)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="452" as="sourcePoint"/><mxPoint x="810" y="452" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="9. approval and passkey answer" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="498" as="sourcePoint"/><mxPoint x="1040" y="498" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="10. check the answer, then sign" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="544" as="sourcePoint"/><mxPoint x="1280" y="544" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m19" value="11. the presentation: only the chosen claims" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="590" as="sourcePoint"/><mxPoint x="580" y="590" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c20" value="12. verifies it, applies the policy,&lt;br&gt;remembers the decision" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#d5e8d4;strokeColor=#82b366;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="475" y="616" width="220" height="40" as="geometry"/></mxCell>
        <mxCell id="m21" value="13. accepted, and where to send the browser back to" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="682" as="sourcePoint"/><mxPoint x="1040" y="682" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m22" value="14. send the browser back" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1040" y="728" as="sourcePoint"/><mxPoint x="810" y="728" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m23" value="15. the browser returns to the app" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="810" y="774" as="sourcePoint"/><mxPoint x="120" y="774" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m24" value="16. read the outcome" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="350" y="820" as="sourcePoint"/><mxPoint x="580" y="820" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m25" value="17. allowed, and who (issuer and email)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="580" y="866" as="sourcePoint"/><mxPoint x="350" y="866" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c26" value="18. the app runs its address rules&lt;br&gt;once and shows the result" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#f5f5f5;strokeColor=#666666;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="250" y="900" width="210" height="40" as="geometry"/></mxCell>
        <mxCell id="c27" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="60" y="960" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c28" value="new component" style="text;html=1;align=left;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="98" y="957" width="330" height="22" as="geometry"/></mxCell>
        <mxCell id="c29" value="" style="rounded=1;html=1;fillColor=#d5e8d4;strokeColor=#82b366;" vertex="1" parent="1"><mxGeometry x="60" y="986" width="28" height="16" as="geometry"/></mxCell>
        <mxCell id="c30" value="attesta" style="text;html=1;align=left;fontSize=11;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="98" y="983" width="330" height="22" as="geometry"/></mxCell>
        <mxCell id="c31" value="Orange arrows need a change in attesta or in the apps; the others work today." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#c55a11;" vertex="1" parent="1"><mxGeometry x="520" y="972" width="900" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page3" name="3 Issuance and lifecycle">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="960" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="Issuance and lifecycle: joiner, mover, leaver" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="900" height="24" as="geometry"/></mxCell>
        <mxCell id="b_emp" value="Employee&lt;br&gt;(browser)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40.0" y="50" width="160" height="46" as="geometry"/></mxCell>
        <mxCell id="l3" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="96" as="sourcePoint"/><mxPoint x="120" y="930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_wal" value="Wallet&lt;br&gt;(UI and service)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="330.0" y="50" width="160" height="46" as="geometry"/></mxCell>
        <mxCell id="l4" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="96" as="sourcePoint"/><mxPoint x="410" y="930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_iss" value="Issuer" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="620.0" y="50" width="160" height="46" as="geometry"/></mxCell>
        <mxCell id="l5" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="96" as="sourcePoint"/><mxPoint x="700" y="930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_idp" value="Identity provider" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="880.0" y="50" width="160" height="46" as="geometry"/></mxCell>
        <mxCell id="l6" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="960" y="96" as="sourcePoint"/><mxPoint x="960" y="930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="b_hr" value="HR system" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="1150.0" y="50" width="160" height="46" as="geometry"/></mxCell>
        <mxCell id="l7" value="" style="endArrow=none;html=1;dashed=1;strokeColor=#999999;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="96" as="sourcePoint"/><mxPoint x="1230" y="930" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c8" value="A. Joiner: the first credential" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="118" width="1340" height="26" as="geometry"/></mxCell>
        <mxCell id="m9" value="1. new employee: department, diploma" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="175" as="sourcePoint"/><mxPoint x="700" y="175" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m10" value="2. opens the wallet, signs in with SSO" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="120" y="221" as="sourcePoint"/><mxPoint x="410" y="221" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m11" value="3. asks for the employee&#x27;s credential (OpenID4VCI)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="267" as="sourcePoint"/><mxPoint x="700" y="267" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m12" value="4. checks who is asking (the same SSO session)" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="313" as="sourcePoint"/><mxPoint x="960" y="313" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m13" value="5. issues it: short-lived, bound to a new key in the KMS" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="359" as="sourcePoint"/><mxPoint x="410" y="359" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c14" value="6. stored in this employee&#x27;s tenant;&lt;br&gt;renewed before it expires" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="305" y="391" width="250" height="44" as="geometry"/></mxCell>
        <mxCell id="c15" value="B. Mover: the department changes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="485" width="1340" height="26" as="geometry"/></mxCell>
        <mxCell id="m16" value="7. department changed" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="540" as="sourcePoint"/><mxPoint x="700" y="540" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m17" value="8. renewal asks again, before the credential expires" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410" y="586" as="sourcePoint"/><mxPoint x="700" y="586" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m18" value="9. new credential with the new department" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;dashed=1;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="700" y="632" as="sourcePoint"/><mxPoint x="410" y="632" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c19" value="10. the old one runs out within days: no revocation list&lt;br&gt;is needed for a first version" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="305" y="664" width="340" height="44" as="geometry"/></mxCell>
        <mxCell id="c20" value="C. Leaver: the employee goes" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#333333;strokeColor=#333333;fontColor=#ffffff;fontStyle=1;align=left;spacingLeft=10;" vertex="1" parent="1"><mxGeometry x="30" y="725" width="1340" height="26" as="geometry"/></mxCell>
        <mxCell id="m21" value="11. employee has left" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#c55a11;fontColor=#c55a11;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="780" as="sourcePoint"/><mxPoint x="410" y="780" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="m22" value="12. stop issuing" style="endArrow=block;html=1;verticalAlign=bottom;fontSize=11;strokeColor=#222222;fontColor=#222222;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1230" y="826" as="sourcePoint"/><mxPoint x="700" y="826" as="targetPoint"/></mxGeometry></mxCell>
        <mxCell id="c23" value="13. the tenant is switched off and its keys destroyed:&lt;br&gt;the wallet is unusable for good" style="shape=note;whiteSpace=wrap;html=1;size=10;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;spacingLeft=6;" vertex="1" parent="1"><mxGeometry x="305" y="858" width="300" height="44" as="geometry"/></mxCell>
        <mxCell id="c24" value="Orange arrows need a change: the issuer and the wallet do not speak this authenticated flow today (the demo issuer uses a pre-authorized offer link)." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#c55a11;" vertex="1" parent="1"><mxGeometry x="40" y="928" width="1300" height="20" as="geometry"/></mxCell>
      </root>
    </mxGraphModel>
  </diagram>
  <diagram id="page4" name="4 Isolation and trust">
    <mxGraphModel dx="1200" dy="800" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="1000" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>
        <mxCell id="c2" value="One wallet per employee, and what keeps them apart" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=16;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="12" width="1000" height="24" as="geometry"/></mxCell>
        <mxCell id="c3" value="Per employee: a tenant" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="30" y="60" width="560" height="600" as="geometry"/></mxCell>
        <mxCell id="b_t0" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="110" width="500" height="240" as="geometry"/></mxCell>
        <mxCell id="c4" value="Tenant: Employee A" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="118" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="b_cred0" value="Credentials&lt;br&gt;encrypted with this tenant&#x27;s data key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="155" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="b_cons0" value="Consent history&lt;br&gt;(who asked, what was shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="155" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="b_key0" value="Holder keys for this employee&lt;br&gt;inside the KMS: the wallet can ask for a signature, never for the key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="250" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="b_t1" value="" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="60" y="380" width="500" height="240" as="geometry"/></mxCell>
        <mxCell id="c5" value="Tenant: Employee B" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=13;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="80" y="388" width="300" height="20" as="geometry"/></mxCell>
        <mxCell id="b_cred1" value="Credentials&lt;br&gt;encrypted with this tenant&#x27;s data key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="425" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="b_cons1" value="Consent history&lt;br&gt;(who asked, what was shared)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="320" y="425" width="220" height="70" as="geometry"/></mxCell>
        <mxCell id="b_key1" value="Holder keys for this employee&lt;br&gt;inside the KMS: the wallet can ask for a signature, never for the key" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="80" y="520" width="460" height="70" as="geometry"/></mxCell>
        <mxCell id="c6" value="Wallet service (shared, holds nothing itself)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="640" y="60" width="380" height="600" as="geometry"/></mxCell>
        <mxCell id="b_ctx" value="Request-scoped tenant context&lt;br&gt;the tenant is the signed-in employee&lt;br&gt;(from the identity provider, never from&lt;br&gt;the request body)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="110" width="330" height="100" as="geometry"/></mxCell>
        <mxCell id="b_gate" value="Approval gate&lt;br&gt;signs only with a fresh passkey answer&lt;br&gt;for exactly this request" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#ffffff;strokeColor=#b85450;arcSize=12;dashed=1;" vertex="1" parent="1"><mxGeometry x="665" y="250" width="330" height="90" as="geometry"/></mxCell>
        <mxCell id="b_reg" value="Verifier registry&lt;br&gt;presents only to registered apps" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="380" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="b_aud" value="Audit log&lt;br&gt;append-only, one entry per presentation" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;arcSize=12;" vertex="1" parent="1"><mxGeometry x="665" y="500" width="330" height="80" as="geometry"/></mxCell>
        <mxCell id="c7" value="Key custody" style="rounded=1;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#999999;dashed=1;dashPattern=6 4;verticalAlign=top;align=left;spacingLeft=10;spacingTop=4;fontStyle=1;fontColor=#555555;arcSize=3;" vertex="1" parent="1"><mxGeometry x="1070" y="60" width="400" height="600" as="geometry"/></mxCell>
        <mxCell id="b_master" value="KMS master key&lt;br&gt;wraps each tenant&#x27;s data key&lt;br&gt;(delete the data key: the tenant is gone)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="110" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="b_hsm" value="KMS / HSM&lt;br&gt;holder keys, non-exportable;&lt;br&gt;IAM: sign yes, export never" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="250" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="b_np" value="Network policy&lt;br&gt;the wallet service may reach only the issuer,&lt;br&gt;the registered verifiers and the KMS" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;arcSize=12;" vertex="1" parent="1"><mxGeometry x="1095" y="390" width="350" height="100" as="geometry"/></mxCell>
        <mxCell id="e8" value="" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.3;exitDx=0;exitDy=0;entryX=1;entryY=0.2;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="b_ctx" target="b_t0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e9" value="" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.7;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="b_ctx" target="b_t1"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e10" value="" style="endArrow=classic;html=1;rounded=0;exitX=0;exitY=0.6;exitDx=0;exitDy=0;entryX=1;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=11;dashed=1;" edge="1" parent="1" source="b_gate" target="b_key0"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="e11" value="asks to sign" style="endArrow=classic;html=1;rounded=0;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;strokeColor=#444444;fontSize=11;" edge="1" parent="1" source="b_gate" target="b_hsm"><mxGeometry relative="1" as="geometry"/></mxCell>
        <mxCell id="c12" value="What an attacker needs, per layer" style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=14;fontColor=#333333;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="40" y="690" width="1400" height="22" as="geometry"/></mxCell>
        <mxCell id="c13" value="•  Steal a session: reaches that one employee&#x27;s wallet, and still cannot present without a passkey answer." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="725" width="1380" height="22" as="geometry"/></mxCell>
        <mxCell id="c14" value="•  Break into the wallet service: can ask for signatures, but only with the approval gate&#x27;s agreement; keys never leave the KMS." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="753" width="1380" height="22" as="geometry"/></mxCell>
        <mxCell id="c15" value="•  Read the database: sees ciphertext only, one data key per tenant, wrapped by the KMS." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="781" width="1380" height="22" as="geometry"/></mxCell>
        <mxCell id="c16" value="•  Present to a rogue verifier: refused, because the registry lists the apps allowed." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="809" width="1380" height="22" as="geometry"/></mxCell>
        <mxCell id="c17" value="•  An employee leaves: their tenant&#x27;s data key and holder keys are destroyed." style="text;html=1;whiteSpace=wrap;verticalAlign=top;align=left;fontSize=12;fontColor=#333333;" vertex="1" parent="1"><mxGeometry x="60" y="837" width="1380" height="22" as="geometry"/></mxCell>
        <mxCell id="c18" value="" style="rounded=1;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;" vertex="1" parent="1"><mxGeometry x="40" y="900" width="28" height="16" as="geometry"/></mxCell>
