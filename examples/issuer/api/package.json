{
  "name": "@attesta/issuer-api",
  "version": "0.1.0",
  "private": true,
  "description": "Demo credential issuer for Attesta, the part wallets and the issuer page talk to: OpenID4VCI endpoints and the JSON API that records entitlements and mails their QR codes.",
  "type": "module",
  "scripts": {
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "pretest": "pnpm --filter @attesta/wallet build",
    "test": "vitest run"
  },
  "dependencies": {
    "@credo-ts/askar": "0.7.2",
    "@credo-ts/core": "0.7.2",
    "@credo-ts/node": "0.7.2",
    "@credo-ts/openid4vc": "0.7.2",
    "@openid4vc/oauth2": "^0.6.0",
    "@openwallet-foundation/askar-nodejs": "0.6.1",
    "express": "^5.2.1",
    "nodemailer": "^7.0.13",
    "pg": "^8.23.1",
    "qrcode": "^1.5.4",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@attesta/wallet": "workspace:*",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/nodemailer": "^7.0.12",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
