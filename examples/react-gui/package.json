{
  "name": "@zk-puoi/react-gui",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "sync-circuit": "mkdir -p public/circuits/cubic && cp ../../client-lib/circuits/cubic/build/cubic_js/cubic.wasm ../../client-lib/circuits/cubic/build/cubic_final.zkey public/circuits/cubic/",
    "predev": "npm run sync-circuit",
    "prebuild": "npm run sync-circuit",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview"
  },
  "dependencies": {
    "@zk-puoi/client": "workspace:*",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
