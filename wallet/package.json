{
  "name": "@attesta/wallet",
  "version": "0.1.0",
  "private": true,
  "description": "attesta credential wallet core: a Credo holder agent that accepts OpenID4VCI offers and stores SD-JWT VCs.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts",
    "serve": "tsx src/serve-cli.ts",
    "test": "vitest run"
  },
  "dependencies": {
    "@azure/identity": "^4.14.0",
    "@azure/keyvault-keys": "^4.10.2",
    "@credo-ts/askar": "0.7.2",
    "@credo-ts/core": "0.7.2",
    "@credo-ts/node": "0.7.2",
    "@credo-ts/openid4vc": "0.7.2",
    "@openwallet-foundation/askar-nodejs": "0.6.1",
    "jpeg-js": "^0.4.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@noble/curves": "^2.4.0",
    "@types/node": "^26.6.4",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "qrcode": "^1.5.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3"
  }
}
