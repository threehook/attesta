      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "cli": "tsx src/cli.ts"
  },
  "dependencies": {
    "@credo-ts/askar": "0.7.2",
    "@credo-ts/core": "0.7.2",
    "@credo-ts/node": "0.7.2",
    "@credo-ts/openid4vc": "0.7.2",
    "@openwallet-foundation/askar-nodejs": "0.6.1",
    "reflect-metadata": "^0.2.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
